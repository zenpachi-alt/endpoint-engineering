{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "Bash(*Test-SensitiveContent* -Sh*)",
      "PowerShell(*Test-SensitiveContent* -Sh*)",
      "Read(.env)",
      "Read(*.env)",
      "Read(secrets.json)",
      "Read(*.secret)",
      "Read(*.pfx)",
      "Read(*.p12)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.publishsettings)"
    ],
    "ask": [
      "Read(*AutopilotHWID*.csv)",
      "Read(*HardwareHash*.csv)",
      "Read(*-Export.csv)",
      "Read(*-Export.json)",
      "Read(*Inventory-*.csv)",
      "Read(*Inventory-*.json)",
      "Read(Reports/**)",
      "Read(Sandbox/**)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "${CLAUDE_PROJECT_DIR}/Tools/Test-EditedScript.ps1"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
